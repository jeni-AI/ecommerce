{% extends 'base.html.twig' %}

{% block title %}Mes commandes | La Boutique Gabonaise{% endblock %}

{% block body %}
    <section class="container py-5 mt-4">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div>
                <p class="text-uppercase text-primary fw-semibold small mb-1">Espace client</p>
                <h1 class="display-6 fw-bold mb-0">Mes commandes</h1>
            </div>
            <a class="btn btn-outline-secondary" href="{{ path('app_home') }}">Retour à la boutique</a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success" role="status">{{ message }}</div>
        {% endfor %}

        <div class="card border-0 shadow-sm">
            {% if orders is empty %}
                <div class="card-body text-center py-5">
                    <h2 class="h4">Vous n’avez pas encore passé de commande</h2>
                    <p class="text-body-secondary">Vos commandes apparaîtront ici après leur validation.</p>
                    <a class="btn btn-primary" href="{{ path('app_home') }}">Découvrir les produits</a>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Référence</th>
                                <th>Date</th>
                                <th>Articles</th>
                                <th>Statut</th>
                                <th>Total</th>
                                <th class="text-end pe-4">Détail</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for order in orders %}
                            <tr>
                                <td class="ps-4 fw-semibold">{{ order.code }}</td>
                                <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
                                <td>{{ order.lignes|length }}</td>
                                <td>{{ order.currentStatus ? order.currentStatus.label : 'En attente' }}</td>
                                <td class="text-nowrap">{{ order.totalAmount|number_format(0, ',', ' ') }} FCFA</td>
                                <td class="text-end pe-4">
                                    <a class="btn btn-sm btn-outline-primary" href="{{ path('app_order_show', {id: order.id}) }}">
                                        Voir la commande
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
