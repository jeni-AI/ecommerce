{% extends 'base.html.twig' %}

{% block title %}Commande {{ order.code }}{% endblock %}

{% block body %}
    <section class="container py-5 mt-4">
        <div class="card border-0 shadow-sm mx-auto" style="max-width: 760px;">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <p class="text-uppercase text-success fw-semibold small mb-2">Commande enregistrée</p>
                    <h1 class="h2 fw-bold">Merci pour votre commande</h1>
                    <p class="text-body-secondary mb-0">Référence : <strong>{{ order.code }}</strong></p>
                </div>

                <h2 class="h5 fw-bold">Articles</h2>
                {% for line in order.lignes %}
                    <div class="d-flex justify-content-between gap-3 py-2 border-bottom">
                        <span>{{ line.product.name }} × {{ line.quantity }}</span>
                        <span class="text-nowrap">{{ line.subtotal|number_format(0, ',', ' ') }} FCFA</span>
                    </div>
                {% endfor %}
                <div class="d-flex justify-content-between fw-bold pt-3 mb-4">
                    <span>Total</span>
                    <span class="text-primary">{{ order.totalAmount|number_format(0, ',', ' ') }} FCFA</span>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <h2 class="h6 fw-bold">Livraison</h2>
                        <p class="mb-1">{{ order.deliveryAddress }}</p>
                        {% if order.deliveryAddressComplement %}<p class="mb-1">{{ order.deliveryAddressComplement }}</p>{% endif %}
                        <p class="mb-1">{{ order.deliveryPostalCode }} {{ order.deliveryCity }}</p>
                        <p class="mb-1">{{ order.deliveryCountry }}</p>
                        <p class="mb-0">{{ order.deliveryPhone }}</p>
                    </div>
                    <div class="col-md-6">
                        <h2 class="h6 fw-bold">Paiement</h2>
                        <p class="mb-1">{{ {
                            'airtel_money': 'Airtel Money',
                            'moov_money': 'Moov Money',
                            'virement_bancaire': 'Virement bancaire',
                            'non_renseigne': 'Non renseigné'
                        }[order.paymentMethod] }}</p>
                        <p class="text-body-secondary mb-0">Statut : en attente de paiement</p>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a class="btn btn-outline-primary me-2" href="{{ path('app_order_index') }}">Mes commandes</a>
                    <a class="btn btn-primary" href="{{ path('app_home') }}">Retour à la boutique</a>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
