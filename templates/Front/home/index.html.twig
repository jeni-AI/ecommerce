{% extends 'base.html.twig' %}

{% block title %}Accueil | La Boutique Gabonaise{% endblock %}

{% block stylesheets %}
    <style>
        .front-catalogue {
            padding-top: 5rem;
        }

        .front-catalogue__hero {
            background: linear-gradient(120deg, #f3f7ff 0%, #f8f9fb 65%, #eef4ff 100%);
            border: 1px solid #e7ecf5;
        }

        .front-catalogue__eyebrow {
            letter-spacing: .12em;
        }

        .front-catalogue__filter {
            border-radius: 1rem;
        }

        .front-catalogue__product {
            border-radius: 1rem;
            overflow: hidden;
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .front-catalogue__product:hover {
            transform: translateY(-4px);
            box-shadow: 0 1rem 2rem rgb(33 37 41 / 12%) !important;
        }

        .front-catalogue__image {
            height: 280px;
            object-fit: contain;
            padding: 1rem;
            background: #f7f8fa;
        }

        .front-catalogue__placeholder {
            height: 280px;
        }

        @media (max-width: 767.98px) {
            .front-catalogue {
                padding-top: 2rem;
            }

            .front-catalogue__image,
            .front-catalogue__placeholder {
                height: 240px;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="front-catalogue">
    <section class="container pb-4">
        <div class="front-catalogue__hero rounded-4 p-4 p-md-5 mb-4">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <p class="front-catalogue__eyebrow text-uppercase text-primary fw-semibold small mb-2">La Boutique Gabonaise</p>
                    <h1 class="display-5 fw-bold mb-3">Découvrez nos produits</h1>
                    <p class="lead text-body-secondary mb-0">
                        Parcourez notre sélection de produits disponibles en boutique.
                    </p>
                </div>
                <div class="col-lg-4 d-flex flex-wrap gap-2 justify-content-lg-end">
                    {% if app.user %}
                        <a class="btn btn-outline-primary" href="{{ path('app_acount') }}">Mon compte</a>
                        {% if is_granted('ROLE_CLIENT') %}
                            <a class="btn btn-primary" href="{{ path('app_cart') }}">Mon panier</a>
                        {% endif %}
                    {% else %}
                        <a class="btn btn-primary" href="{{ path('app_register') }}">Créer un compte</a>
                        <a class="btn btn-outline-secondary" href="{{ path('app_login') }}">Se connecter</a>
                    {% endif %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <a class="btn btn-dark" href="{{ path('app_home_back') }}">Back-office</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>

    <section class="container pb-5" aria-labelledby="catalogue-title">
        <div class="row g-4">
            <aside class="col-lg-3">
                <div class="front-catalogue__filter card border-0 shadow-sm">
                    <div class="card-body">
                        <h2 class="h5 fw-semibold mb-4">Rechercher et filtrer</h2>
                        <form method="get" action="{{ path('app_home') }}">
                            <div class="mb-3">
                                <label class="form-label" for="catalog-search">Produit</label>
                                <input class="form-control" id="catalog-search" type="search" name="q"
                                       value="{{ filters.q }}" placeholder="Nom ou description">
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="catalog-category">Catégorie</label>
                                <select class="form-select" id="catalog-category" name="category">
                                    <option value="">Toutes les catégories</option>
                                    {% for category in categories %}
                                        <option value="{{ category.id }}" {{ filters.category == category.id ? 'selected' : '' }}>
                                            {{ category.label }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="catalog-brand">Marque</label>
                                <select class="form-select" id="catalog-brand" name="brand">
                                    <option value="">Toutes les marques</option>
                                    {% for brand in brands %}
                                        <option value="{{ brand.id }}" {{ filters.brand == brand.id ? 'selected' : '' }}>
                                            {{ brand.label }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label" for="catalog-min-price">Prix min.</label>
                                    <input class="form-control" id="catalog-min-price" type="number" min="0"
                                           name="min_price" value="{{ filters.min_price ?? '' }}">
                                </div>
                                <div class="col-6">
                                    <label class="form-label" for="catalog-max-price">Prix max.</label>
                                    <input class="form-control" id="catalog-max-price" type="number" min="0"
                                           name="max_price" value="{{ filters.max_price ?? '' }}">
                                </div>
                            </div>
                            <button class="btn btn-primary w-100" type="submit">Appliquer les filtres</button>
                            <a class="btn btn-link w-100 mt-2" href="{{ path('app_home') }}">Réinitialiser</a>
                        </form>
                    </div>
                </div>
            </aside>

            <div class="col-lg-9">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <p class="text-uppercase text-primary fw-semibold small mb-1">La sélection</p>
                        <h2 class="h3 fw-bold mb-0" id="catalogue-title">Notre catalogue</h2>
                    </div>
                    <span class="badge rounded-pill text-bg-light border px-3 py-2">{{ products|length }} produit(s)</span>
                </div>

                <div class="row row-cols-1 row-cols-md-2 g-4">
                    {% for product in products %}
                        <div class="col">
                            <article class="front-catalogue__product card h-100 border-0 shadow-sm">
                                {% if product.image %}
                                    <img src="{{ asset('uploads/' ~ product.image) }}"
                                         class="front-catalogue__image card-img-top" alt="{{ product.name }}">
                                {% else %}
                                    <div class="front-catalogue__placeholder bg-light d-flex align-items-center justify-content-center text-body-secondary"
                                         role="img" aria-label="Aucune image pour {{ product.name }}">
                                        Image non disponible
                                    </div>
                                {% endif %}
                                <div class="card-body d-flex flex-column">
                                    <p class="small text-uppercase text-body-secondary mb-2">
                                        {{ product.category.label }} · {{ product.brand.label }}
                                    </p>
                                    <h3 class="h4 card-title fw-semibold">{{ product.name }}</h3>
                                    {% if product.description %}
                                        <p class="card-text text-body-secondary mb-4">
                                            {{ product.description|length > 110 ? product.description|slice(0, 110) ~ '…' : product.description }}
                                        </p>
                                    {% endif %}
                                    <div class="mt-auto">
                                        <div class="d-flex justify-content-between align-items-end gap-3">
                                            <p class="h4 fw-bold text-primary mb-0">{{ product.price|number_format(0, ',', ' ') }} FCFA</p>
                                            {% if product.stock > 0 %}
                                                <span class="small text-success text-nowrap">En stock : {{ product.stock }}</span>
                                            {% else %}
                                                <span class="small text-danger text-nowrap">Indisponible</span>
                                            {% endif %}
                                        </div>
                                        {% if is_granted('ROLE_CLIENT') and product.stock > 0 %}
                                            <form class="js-cart-add mt-3" action="{{ path('app_cart_add', {id: product.id}) }}" method="post">
                                                <input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}">
                                                <input type="hidden" name="quantity" value="1">
                                                <button class="btn btn-primary w-100" type="submit">Ajouter au panier</button>
                                            </form>
                                        {% elseif not app.user and product.stock > 0 %}
                                            <a class="btn btn-outline-primary w-100 mt-3" href="{{ path('app_login') }}">Connectez-vous pour commander</a>
                                        {% endif %}
                                        <a class="btn btn-link w-100 mt-2" href="{{ path('app_front_product_show', {id: product.id}) }}">
                                            Voir le détail
                                        </a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    {% else %}
                        <div class="col-12">
                            <div class="alert alert-info mb-0" role="status">
                                Aucun produit publié ne correspond à votre recherche.
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>
    </div>
    <div class="container">
        <div class="alert alert-success d-none" role="status" data-cart-message></div>
        <div class="alert alert-danger d-none" role="alert" data-cart-error></div>
    </div>
    <script>
        $(function () {
            $('.js-cart-add').on('submit', function (event) {
                event.preventDefault();
                const form = $(this);
                const button = form.find('button');
                button.prop('disabled', true);

                $.ajax({
                    url: form.attr('action'),
                    method: 'POST',
                    data: form.serialize(),
                    dataType: 'json'
                }).done(function (response) {
                    $('[data-cart-error]').addClass('d-none');
                    $('[data-cart-message]').text(response.message).removeClass('d-none');
                }).fail(function (xhr) {
                    const message = xhr.responseJSON?.message || 'Impossible d’ajouter ce produit au panier.';
                    $('[data-cart-message]').addClass('d-none');
                    $('[data-cart-error]').text(message).removeClass('d-none');
                }).always(function () {
                    button.prop('disabled', false);
                });
            });
        });
    </script>
{% endblock %}
