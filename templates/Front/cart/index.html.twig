{% extends 'base.html.twig' %}

{% block title %}Mon panier | La Boutique Gabonaise{% endblock %}

{% block body %}
    <section class="container py-5 mt-4">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success" role="status">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('danger') %}
            <div class="alert alert-danger" role="alert">{{ message }}</div>
        {% endfor %}
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div>
                <p class="text-uppercase text-primary fw-semibold small mb-1">Votre sélection</p>
                <h1 class="display-6 fw-bold mb-0">Mon panier</h1>
            </div>
            <a class="btn btn-outline-secondary" href="{{ path('app_home') }}">Continuer mes achats</a>
        </div>

        <div class="alert alert-danger d-none" role="alert" data-cart-error></div>

        {% if cart.lignes is empty %}
            <div class="card border-0 shadow-sm" data-cart-empty>
                <div class="card-body text-center py-5">
                    <h2 class="h4">Votre panier est vide</h2>
                    <p class="text-body-secondary">Parcourez le catalogue pour trouver un produit qui vous plaît.</p>
                    <a class="btn btn-primary" href="{{ path('app_home') }}">Voir les produits</a>
                </div>
            </div>
        {% else %}
            <div class="row g-4" data-cart-content>
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Produit</th>
                                        <th>Prix unitaire</th>
                                        <th>Quantité</th>
                                        <th>Sous-total</th>
                                        <th><span class="visually-hidden">Action</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for line in cart.lignes %}
                                    <tr data-cart-line data-subtotal="{{ line.subtotal }}">
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-3">
                                                {% if line.product.image %}
                                                    <img src="{{ asset('uploads/' ~ line.product.image) }}" alt=""
                                                         width="64" height="64" class="rounded object-fit-contain bg-light p-1">
                                                {% endif %}
                                                <div>
                                                    <span class="fw-semibold">{{ line.product.name }}</span>
                                                    <div class="small text-body-secondary">{{ line.product.brand.label }}</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-nowrap">{{ line.product.price|number_format(0, ',', ' ') }} FCFA</td>
                                        <td>
                                            <form class="js-cart-update d-flex align-items-center gap-2"
                                                  action="{{ path('app_cart_update', {id: line.id}) }}" method="post">
                                                <input type="hidden" name="_token" value="{{ csrf_token('cart_update_' ~ line.id) }}">
                                                <label class="visually-hidden" for="quantity-{{ line.id }}">Quantité pour {{ line.product.name }}</label>
                                                <input class="form-control form-control-sm" id="quantity-{{ line.id }}"
                                                       type="number" name="quantity" value="{{ line.quantity }}" min="1"
                                                       max="{{ line.product.stock }}" style="width: 5rem;">
                                                <button class="btn btn-sm btn-outline-primary" type="submit">Mettre à jour</button>
                                            </form>
                                        </td>
                                        <td class="text-nowrap fw-semibold" data-line-subtotal>
                                            {{ line.subtotal|number_format(0, ',', ' ') }} FCFA
                                        </td>
                                        <td class="pe-3">
                                            <form class="js-cart-remove"
                                                  action="{{ path('app_cart_remove', {id: line.id}) }}" method="post">
                                                <input type="hidden" name="_token" value="{{ csrf_token('cart_remove_' ~ line.id) }}">
                                                <button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Supprimer {{ line.product.name }}">
                                                    Supprimer
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <aside class="col-lg-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="h5 fw-bold mb-4">Récapitulatif</h2>
                            <div class="d-flex justify-content-between mb-3">
                                <span>Articles</span>
                                <span data-cart-item-count>{{ itemCount }}</span>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <span class="fw-semibold">Total</span>
                                <strong class="h4 text-primary mb-0" data-cart-total>{{ total|number_format(0, ',', ' ') }} FCFA</strong>
                            </div>
                            <p class="small text-body-secondary mb-0">
                                Le stock et le montant seront vérifiés à la validation de la commande.
                            </p>
                            <a class="btn btn-primary btn-lg w-100 mt-4" href="{{ path('app_order_checkout') }}">
                                Passer la commande
                            </a>
                        </div>
                    </div>
                </aside>
            </div>
            <div class="card border-0 shadow-sm d-none" data-cart-empty>
                <div class="card-body text-center py-5">
                    <h2 class="h4">Votre panier est vide</h2>
                    <p class="text-body-secondary">Parcourez le catalogue pour trouver un produit qui vous plaît.</p>
                    <a class="btn btn-primary" href="{{ path('app_home') }}">Voir les produits</a>
                </div>
            </div>
        {% endif %}
    </section>

    <script>
        $(function () {
            const formatAmount = (amount) => new Intl.NumberFormat('fr-FR').format(amount) + ' FCFA';

            function showCartError(xhr) {
                const message = xhr.responseJSON?.message || 'La mise à jour du panier a échoué.';
                $('[data-cart-error]').text(message).removeClass('d-none');
            }

            function updateSummary(response) {
                $('[data-cart-error]').addClass('d-none');
                $('[data-cart-total]').text(formatAmount(response.total));
                $('[data-cart-item-count]').text(response.itemCount);
            }

            $('.js-cart-update').on('submit', function (event) {
                event.preventDefault();
                const form = $(this);
                const button = form.find('button');
                button.prop('disabled', true);

                $.ajax({
                    url: form.attr('action'),
                    method: 'POST',
                    data: form.serialize(),
                    dataType: 'json'
                }).done(function (response) {
                    updateSummary(response);
                    form.closest('[data-cart-line]').find('[data-line-subtotal]').text(formatAmount(response.lineSubtotal));
                }).fail(showCartError).always(function () {
                    button.prop('disabled', false);
                });
            });

            $('.js-cart-remove').on('submit', function (event) {
                event.preventDefault();
                const form = $(this);
                const button = form.find('button');
                button.prop('disabled', true);

                $.ajax({
                    url: form.attr('action'),
                    method: 'POST',
                    data: form.serialize(),
                    dataType: 'json'
                }).done(function (response) {
                    updateSummary(response);
                    form.closest('[data-cart-line]').remove();

                    if (response.isEmpty) {
                        $('[data-cart-content]').remove();
                        $('[data-cart-empty]').removeClass('d-none').show();
                    }
                }).fail(showCartError).always(function () {
                    button.prop('disabled', false);
                });
            });
        });
    </script>
{% endblock %}
