<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Connexion administrateur</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <main class="container min-vh-100 d-flex align-items-center justify-content-center">
        <div class="card shadow-sm border-0 w-100" style="max-width: 440px">
            <div class="card-body p-4">
                <h1 class="h3 mb-4">Connexion administrateur</h1>
                {% for message in app.flashes('danger') %}
                    <div class="alert alert-danger" role="alert">{{ message }}</div>
                {% endfor %}
                {% if error %}
                    <div class="alert alert-danger" role="alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}
                {% if app.user %}
                    <div class="alert alert-info" role="status">
                        Une session est déjà ouverte pour {{ app.user.userIdentifier }}.
                        Pour changer de compte, déconnectez-vous d’abord.
                        <a class="alert-link" href="{{ path(is_granted('ROLE_ADMIN') ? 'app_admin_logout' : 'app_logout') }}">
                            Se déconnecter
                        </a>
                    </div>
                {% endif %}
                <form action="{{ path('app_admin_login') }}" method="post">
                    <div class="mb-3">
                        <label class="form-label" for="username">Adresse e-mail</label>
                        <input class="form-control" type="email" id="username" name="_username" value="{{ last_username }}" required autocomplete="username">
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="password">Mot de passe</label>
                        <input class="form-control" type="password" id="password" name="_password" required autocomplete="current-password">
                    </div>
                    <button class="btn btn-primary w-100" type="submit">Se connecter</button>
                </form>
                <a class="d-inline-block mt-3" href="{{ path('app_login') }}">Connexion client</a>
            </div>
        </div>
    </main>
</body>
</html>
