{% extends is_granted('ROLE_ADMIN') ? 'base-back.html.twig' : 'base.html.twig' %}
{% block title %}Modifier le mot de passe{% endblock %}
{% block body %}
<div class="container my-5">
    <h1>Modifier le mot de passe</h1>
    {{ form_start(modifyPasswordForm) }}
        {{ form_widget(modifyPasswordForm) }}
        <button type="submit" class="btn btn-success mt-3">Renouveler le mot de passe</button>
    {{ form_end(modifyPasswordForm) }}
    <a href="{{ path(profileRoute) }}" class="btn btn-link mt-3">Retour à mon compte</a>
</div>
{% endblock %}