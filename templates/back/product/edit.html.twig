{% extends 'base-back.html.twig' %}

{% block title %}Modifier {{ product.name }} | La Boutique{% endblock %}

{% block body %}
    <div class="container py-4">
        <a class="small text-decoration-none" href="{{ path('app_product_index') }}">← Retour au catalogue</a>
        <div class="row justify-content-center mt-3">
            <div class="col-lg-8 col-xl-7">
                <div class="mb-4">
                    <p class="text-uppercase text-primary fw-semibold small mb-1">Catalogue · Réf. #{{ product.id }}</p>
                    <h1 class="h2 fw-bold mb-1">Modifier le produit</h1>
                    <p class="text-body-secondary mb-0">{{ product.name }}</p>
                </div>
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4 p-md-5">
                        {{ include('back/product/_form.html.twig', {
                            button_label: 'Enregistrer les modifications',
                            button_class: 'btn-primary'
                        }) }}
                    </div>
                </div>
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mt-4 p-3 border rounded">
                    <div>
                        <p class="fw-semibold mb-1">Supprimer ce produit</p>
                        <p class="small text-body-secondary mb-0">Cette action est définitive.</p>
                    </div>
                    {{ include('back/product/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
