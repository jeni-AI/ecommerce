{% extends 'base-back.html.twig' %}

{% block title %}Ajouter un rôle{% endblock %}

{% block body %}
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <a class="btn btn-link px-0 text-decoration-none mb-3" href="{{ path('app_role') }}">Retour aux rôles</a>
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white p-4">
                        <h1 class="h2 fw-bold mb-0">Ajouter un rôle</h1>
                    </div>
                    <div class="card-body p-4">
                        {{ include('back/role/_form.html.twig', {button_label: 'Créer le rôle'}) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
