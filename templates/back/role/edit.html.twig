{% extends 'base-back.html.twig' %}

{% block title %}Modifier un rôle{% endblock %}

{% block body %}
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <a class="btn btn-link px-0 text-decoration-none mb-3" href="{{ path('app_role') }}">Retour aux rôles</a>
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white p-4">
                        <h1 class="h2 fw-bold mb-0">Modifier le rôle {{ role.label }}</h1>
                    </div>
                    <div class="card-body p-4">
                        {{ include('back/role/_form.html.twig', {button_label: 'Enregistrer les modifications'}) }}
                    </div>
                </div>
                <div class="mt-4 p-3 border rounded d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                    <p class="fw-semibold mb-0">Supprimer ce rôle</p>
                    {{ include('back/role/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
