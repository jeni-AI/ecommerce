{% extends 'base-back.html.twig' %}

{% block title %}Ajouter une catégorie{% endblock %}

{% block body %}
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <a class="btn btn-link px-0 text-decoration-none mb-3" href="{{ path('app_category_index') }}">Retour aux catégories</a>
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white p-4">
                        <p class="text-uppercase text-primary fw-semibold small mb-1">Référentiels</p>
                        <h1 class="h2 fw-bold mb-0">Ajouter une catégorie</h1>
                    </div>
                    <div class="card-body p-4">
                        {{ include('back/category/_form.html.twig', {button_label: 'Créer la catégorie'}) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
