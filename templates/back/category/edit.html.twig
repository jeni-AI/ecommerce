{% extends 'base-back.html.twig' %}

{% block title %}Modifier la catégorie{% endblock %}

{% block body %}
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <a class="btn btn-link px-0 text-decoration-none mb-3" href="{{ path('app_category_index') }}">Retour aux catégories</a>
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white p-4">
                        <p class="text-uppercase text-primary fw-semibold small mb-1">Catégorie #{{ category.id }}</p>
                        <h1 class="h2 fw-bold mb-0">Modifier la catégorie</h1>
                    </div>
                    <div class="card-body p-4">
                        {{ include('back/category/_form.html.twig', {button_label: 'Enregistrer les modifications'}) }}
                    </div>
                </div>
                <div class="mt-4 p-3 border rounded d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                    <div>
                        <p class="fw-semibold mb-1">Supprimer cette catégorie</p>
                        <p class="small text-body-secondary mb-0">Cette action est définitive.</p>
                    </div>
                    {{ include('back/category/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
