{% extends 'base-back.html.twig' %}

{% block title %}Modifier un utilisateur{% endblock %}

{% block body %}
    <div class="container my-5">
        <h1>Modifier un utilisateur</h1>
        <p class="text-muted">Laissez le mot de passe vide pour le conserver.</p>

        {{ form_start(form) }}
            {{ form_widget(form) }}
        {{ form_end(form) }}

        <a class="btn btn-link px-0" href="{{ path('app_users') }}">Retour à la liste</a>
    </div>
{% endblock %}
