{% extends 'base-back.html.twig' %}

{% block title %}Liste des utilisateurs{% endblock %}

{% block body %}
    <div class="container my-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Liste des utilisateurs</h1>
            <a class="btn btn-primary" href="{{ path('app_admin_user_new') }}"
               title="Ajouter un utilisateur" aria-label="Ajouter un utilisateur">
                <i class="bi bi-person-plus"></i>
            </a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success" role="alert">{{ message }}</div>
        {% endfor %}
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Prénom</th>
                        <th>Nom</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th>Connexion</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
            {% for user in users %}
                    <tr>
                        <td>{{ user.firstname }}</td>
                        <td>{{ user.lastname }}</td>
                        <td>{{ user.email }}</td>
                        <td>{{ user.role ? user.role.label : 'Aucun rôle' }}</td>
                        <td>
                            <span class="badge {{ user.isValid ? 'text-bg-success' : 'text-bg-secondary' }}" data-user-status>
                                {{ user.isValid ? 'Activée' : 'Désactivée' }}
                            </span>
                        </td>
                         <td>
                            <div class="d-flex gap-2 align-items-center">
                                {% if user.role.code == 'ROLE_ADMIN' %}
                                    <span class="text-muted small d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-shield-lock"></i> Administrateur protégé
                                    </span>
                                {% elseif app.user.id != user.id %}
                                    <button
                                        type="button"
                                        class="btn btn-link p-0 fs-5 {{ user.isValid ? 'text-success' : 'text-secondary' }}"
                                        data-user-toggle
                                        data-url="{{ path('app_user_toggle_validity', {id: user.id}) }}"
                                        data-csrf="{{ csrf_token('toggle-user' ~ user.id) }}"
                                        data-is-valid="{{ user.isValid ? 'true' : 'false' }}"
                                        title="{{ user.isValid ? 'Compte activé — cliquer pour désactiver' : 'Compte désactivé — cliquer pour activer' }}"
                                        aria-label="{{ user.isValid ? 'Compte activé — cliquer pour désactiver' : 'Compte désactivé — cliquer pour activer' }}"
                                    >
                                        <i class="bi {{ user.isValid ? 'bi-check-circle-fill' : 'bi-check-circle' }}" data-user-toggle-icon aria-hidden="true"></i>
                                    </button>
                                {% endif %}

                                <a class="btn btn-sm btn-outline-primary" href="{{ path('app_user_edit', {id: user.id}) }}"
                                   title="Modifier" aria-label="Modifier">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <form method="post" action="{{ path('app_user_delete', {id: user.id}) }}"
                                      onsubmit="return confirm('Confirmer la suppression de cet utilisateur ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            title="Supprimer" aria-label="Supprimer">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
            {% else %}
                    <tr><td colspan="6" class="text-center">Aucun utilisateur trouvé.</td></tr>
            {% endfor %}
                </tbody>
            </table>

        </div>
    </div>
{% endblock %}