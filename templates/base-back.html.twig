<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <link  rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" >
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Back-Office{% endblock %}</title>
    <style>
      .admin-layout {
        flex: 1;
      }

      .admin-content {
        flex: 1;
        padding: 20px;
      }

      #offcanvasNavbar {
        --bs-offcanvas-width: 250px;
      }
    </style>
  </head>
  <body class="d-flex flex-column min-vh-100 m-0">

    {% include 'header-back.html.twig' %}

    <div class="bg-light border-bottom px-3 py-2">
        <button class="btn btn-outline-dark" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar">
            Menu
        </button>
    </div>

    {% include 'base-menu.html.twig' %}

    <div class="admin-layout d-flex">
        <main class="admin-content">
            {% block body %}{% endblock %}
        </main>
    </div>

    {% include 'footer-back.html.twig' %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    {% include 'base_js.html.twig' %}
  </body>
</html>
